# PostgreSQL (provided by notes_database container)
POSTGRES_URL=localhost
POSTGRES_PORT=5000
POSTGRES_DB=myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change_me

# JWT auth
JWT_SECRET_KEY=change_me_super_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# CORS (comma-separated origins or "*")
CORS_ALLOW_ORIGINS=*
